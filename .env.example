# CyberShield Environment Variables

# GitHub OAuth 2.0 App Configuration
# 1. Open: https://github.com/settings/developers
# 2. Click "New OAuth App"
#    - Application name: CyberShield
#    - Homepage URL: http://localhost:3000
#    - Authorization callback URL: http://localhost:3000/api/auth/github/callback
# 3. Copy Client ID and generate a Client Secret, then paste below:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Token Secret
JWT_SECRET=cybershield-dev-secret-key-32-chars-min!!
